# ─────────────────────────────────────────────────────────────
#  Seller-bot — PRODUCTION config for seller-bot.example.com
#  On the server:  cp .env.production.example .env  &&  заполнить значения
# ─────────────────────────────────────────────────────────────

# === Telegram ===
# Токен бота от @BotFather (можно ввести и в админке).
BOT_TOKEN=

# === Веб / домен ===
BASE_URL=https://seller-bot.example.com
HOST=0.0.0.0
PORT=8000

# === База данных ===
# SQLite в томе Docker (sellerbot-data). Для масштаба можно перейти на PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:pass@host/sellerbot
DATABASE_URL=sqlite+aiosqlite:///./data/sellerbot.db

# === Админ-панель ===
ADMIN_USERNAME=admin
# По умолчанию admin / admin — СМЕНИТЕ перед публикацией админки в интернет:
ADMIN_PASSWORD=admin
# Сгенерируйте: openssl rand -hex 32
SECRET_KEY=

# === ИИ-менеджер (OpenAI-совместимый API) — также настраивается в админке ===
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-5.5
LLM_TEMPERATURE=0.4

# === Прочее ===
TIMEZONE=Asia/Almaty
CURRENCY=KZT
# Сайт компании, чья форма шлёт заявки в /leads (через запятую)
SITE_ORIGINS=
LOG_LEVEL=INFO
