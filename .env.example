# ─────────────────────────────────────────────────────────────
#  Seller-bot — пример конфигурации. Скопируйте в .env и заполните.
#  cp .env.example .env
# ─────────────────────────────────────────────────────────────

# === Telegram ===
# Токен бота от @BotFather
BOT_TOKEN=

# === Веб-сервер ===
# Публичный URL (для вебхуков платёжных систем). Локально можно оставить localhost.
BASE_URL=http://localhost:8000
HOST=0.0.0.0
PORT=8000

# === База данных ===
# По умолчанию SQLite в ./data/sellerbot.db. Для PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost/sellerbot
DATABASE_URL=sqlite+aiosqlite:///./data/sellerbot.db

# === Админ-панель ===
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
# Секрет для подписи сессий админки. ОБЯЗАТЕЛЬНО смените на длинную случайную строку.
SECRET_KEY=change-me-please-to-a-long-random-string

# === ИИ-менеджер (OpenAI-совместимый API; переопределяется в админке) ===
# Подходит OpenAI / DeepSeek / OpenRouter / Gemini(совм.) / локальный Ollama (http://localhost:11434/v1)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-5.5
LLM_TEMPERATURE=0.4

# === Прочее ===
TIMEZONE=Asia/Almaty
CURRENCY=KZT
# Сайт компании, чья форма шлёт заявки в /leads (через запятую)
SITE_ORIGINS=
LOG_LEVEL=INFO
